# Telegram bot token: set only in the backend host's private environment settings.
BOT_TOKEN=
MINI_APP_URL=https://YOUR_GITHUB_USERNAME.github.io/YOUR_REPOSITORY/
VITE_API_URL=https://YOUR_BACKEND_HOST

# Comma-separated Telegram numeric user IDs. Never expose this value to the frontend.
ADMIN_TELEGRAM_IDS=

# Backend settings
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
WEBAPP_MAX_AUTH_AGE_SECONDS=86400
CORS_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io,http://localhost:5173
AD_TIMEZONE=Asia/Tashkent
